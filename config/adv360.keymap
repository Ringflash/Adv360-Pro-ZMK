//    │ & │ Z │ X │ C │ V │ B │           │ & │ & │                     │ N │ M │ & │ & │ & │ & │
//    ├───┼───┼───┼───┼───┼───┘   ┌───┬───┼───┼───┼───┬───┐             └───┼───┼───┼───┼───┼───┤
//    │ & │ & │ & │ & │ & │       │ & │ & │ & │ & │ & │ & │                 │ & │ & │ & │ & │ & │
