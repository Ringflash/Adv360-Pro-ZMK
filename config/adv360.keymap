      >;
    };
    mac { 
    // TODO: finish
    // TODO: check &trans
    // TODO: cluster &ht_cl
      display-name = "MacOS";
      bindings = <
  &trans   &trans   &trans   &trans   &trans   &trans   &ht_dfn_mfst LG(LS(N3)) LG(LS(N4))                                                                      &trans          &trans   &trans   &trans   &trans   &trans   &trans
  &trans   &trans   &trans   &trans   &trans   &trans   &ht_dfn_mfst LG(LS(LC(W))) LG(LC(LA(W)))                                                                &to L_DEFAULT   &trans   &trans   &trans   &trans   &trans   &trans
  &trans   &trans   &trans   &trans   &trans   &trans   &trans                                              &kp LGUI   &trans   &kp LCTRL   &kp RGUI            &kp LC(SPACE)   &trans   &trans   &trans   &trans   &trans   &trans
  &trans   &trans   &trans   &trans   &trans   &trans                                                                  &trans   &trans                                          &trans   &trans   &trans   &trans   &trans   &trans
  &trans   &trans   &trans   &trans   &trans                                                       &trans   &trans     &trans   &trans      &trans     &trans                            &trans   &trans   &trans   &trans   &kp LG(SPACE)
//    ┌───┬───┬───┬───┬───┬───┬────────────┐                                ┌─────────────┬───┬───┬───┬───┬───┬──────┐
//    │ & │ & │ & │ & │ & │ & │ screenshot │                                │      &      │ & │ & │ & │ & │ & │  &   │
//    ├───┼───┼───┼───┼───┼───┼────────────┤                                ├─────────────┼───┼───┼───┼───┼───┼──────┤
//    │ & │ & │ & │ & │ & │ & │ < worksp > │                                │ to L_DEFAU< │ & │ & │ & │ & │ & │  &   │
//    ├───┼───┼───┼───┼───┼───┼────────────┤   ┌──────┬───┬──────┬──────┐   ├─────────────┼───┼───┼───┼───┼───┼──────┤
