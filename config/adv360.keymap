//    │  lsft   │ Z │    X     │  C   │  D   │ V │                                         │ home │ pgup │                                        │ K │ H  │  ,   │ . │ / │ rsft │
//    ├─────────┼───┼──────────┼──────┼──────┼───┘             ┌─────┬─────────────────────┼──────┼──────┼────────────────────┬──────┐            └───┼────┼──────┼───┼───┼──────┤
//    │ Tools L │ ` │ caps duo │ left │ rght │                 │ spc │ &ht_cl L_KEYPAD ent │ end  │ pgdn │ &ht_cl L_MEDIA del │ bspc │                │ up │ down │ [ │ ] │ lang │
