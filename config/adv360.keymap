  &ht_dfn_mfst LG(J) LG(LC(J))       &none                    &kp LG(LEFT)             &kp LG(DOWN)    &kp LG(RIGHT)       &ht_mo_tog L_HYPR_GR L_HYPR_GR   &kp LG(LS(K))                                    &trans   &trans   &trans   &trans                   &none   &kp LG(RBKT)    &kp LG(KP_N4)   &kp LG(KP_N5)   &kp LG(KP_N6)   &none        &none
  &ht_dfn_mfst LG(LA(J)) LG(LS(J))   &none                    &td_a4_h_res             &kp LG(LA(S))   &kp LG(LC(LA(H)))   &none                                                                                      &none    &none                                     &kp LG(LBKT)    &kp LG(KP_N1)   &kp LG(KP_N2)   &kp LG(KP_N3)   &none        &trans
  &kp LG(LA(M))                      &kp LG(LS(LC(LA(N1))))   &kp LG(LS(LC(LA(N2))))   &none           &none                                                                               &tog L_HYPRLAND   &none    &none    &none    &none    &kp LG(KP_N0)                           &none           &none           &none           &none        &none
