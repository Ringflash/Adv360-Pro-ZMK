#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/* PREPROCESSOR */
// Constants
#define TAP_TERM_DEF 180
#define TAP_TERM_MFAST 130
#define TAP_TERM_FAST 150
// Layers
#define L_DEFAULT 0
#define L_QWERTY 1
#define L_MAC 2
#define L_MEDIA 3
#define L_KEYPAD 4
#define L_FTOOLS 5
#define L_FTOOLS_MAC 6
#define L_HYPRLAND 7
#define L_HYPR_GR 8
#define L_AEROSPACE 9
#define L_APPS 10
#define L_EDITOR 11
// Macros
// - tap, hold, double tap
#define TD_A3(NAME, TAP, HOLD, D_TAP) \
    NAME: NAME { \
        compatible = "zmk,behavior-tap-dance"; \
        #binding-cells = <0>; \
        tapping-term-ms = <TAP_TERM_DEF>; \
        bindings = <&ht_dfn_mfst HOLD TAP>, <&kp D_TAP>; \
    };
#define TD_A4(NAME, TAP, HOLD, D_TAP, T_TAP) \
    NAME: NAME { \
        compatible = "zmk,behavior-tap-dance"; \
        #binding-cells = <0>; \
        tapping-term-ms = <TAP_TERM_DEF>; \
        bindings = <&ht_dfn_mfst HOLD TAP>, <&kp D_TAP>, <&kp T_TAP>; \
    };

// Default behaviors
&mt { // Mod-Tap
    tapping-term-ms = <TAP_TERM_DEF>;
};
&lt { // Layer-Tap
    tapping-term-ms = <TAP_TERM_DEF>;
};
&sk { // Sticky key
    release-after-ms = <1500>;
};
&sl { // Sticky layer
    release-after-ms = <1500>;
};
&caps_word {
    continue-list = <UNDERSCORE MINUS BACKSPACE DELETE>;
};

// Config
/ {
    behaviors {
      /* #include "macros.dtsi" */
      /* #include "version.dtsi" */
        // Custom
        ht_cl: ht_cluster_layer {
        // TODO: setup tapping term
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred"; 
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;     
            retro-tap;          
            bindings = <&mo>, <&kp>;
        };
        test_lp: test_layer_press {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;      
            retro-tap;                 
            bindings = <&mo>, <&kp>;   
        };
        ht_dfn_mfst: ht_dual_function_mega_fast {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred"; 
            tapping-term-ms = <TAP_TERM_MFAST>;
            quick-tap-ms = <0>;     
            retro-tap;          
            bindings = <&kp>, <&kp>;
        };
        ht_mo_sl: ht_momentary_sticky_layer { 
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <TAP_TERM_FAST>;
            bindings = <&mo>, <&sl>; 
        };
        ht_mo_tog: ht_momentary_toggle_layer { 
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <TAP_TERM_FAST>;
            bindings = <&mo>, <&tog>; 
        };
        // DELETE: maybe ^
        cw_caps: caps_word_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <135>;
            quick-tap-ms = <0>;
            bindings = <&kp>, <&caps_word>; 
        };
        // - Keyboard layout (qwerty/mac) switch on hold and double tap 
        to_hold_tap: to_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <TAP_TERM_DEF>;
            bindings = <&to>, <&none>;
        };
        td_layout: td_change_layout {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TAP_TERM_DEF>;
            bindings = <&to_hold_tap L_MAC 0>, <&to L_QWERTY>; 
        };
        // tap-dance
        /* td_kp3: tap_dance_tap_hold_double_tap { */
        /*     compatible = "zmk,behavior-tap-dance"; */
        /*     #binding-cells = <0>; */
        /*     tapping-term-ms = <200>; */
        /*     bindings = <&mt LSHIFT CAPSLOCK>, <&kp LCTRL>; */
        /* }; */
        // TODO: change for A4
        TD_A3(td_a3_h_res, LG(R), LG(LC(R)), LG(LA(R))) // hyprland, resize window
        // macro
        m_p2: macro_two_param {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>; 
            bindings =
                <&macro_param_1to1>,
                <&macro_tap &kp MACRO_PLACEHOLDER>,
                <&macro_param_2to1>,
                <&macro_tap &kp MACRO_PLACEHOLDER>;
        };
        m_p2_s: macro_two_param_with_space {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>; 
            bindings =
                <&macro_param_1to1>,
                <&macro_tap &kp MACRO_PLACEHOLDER>,
                <&macro_param_2to1>,
                <&macro_tap &kp MACRO_PLACEHOLDER>,
                <&macro_tap &kp SPACE>;
        };
        m_brkt: macro_brackets_left_left {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>; 
            bindings =
                <&macro_tap &kp LEFT_BRACKET>,               
                <&macro_param_1to1>,
                <&macro_tap &kp MACRO_PLACEHOLDER>,
                <&macro_param_1to1>,
                <&macro_tap &kp MACRO_PLACEHOLDER>,
                <&macro_tap &kp RIGHT_BRACKET>,
                <&macro_tap &kp LEFT_ARROW &kp LEFT_ARROW>;
        };
        m_paren: macro_parenthesis_left_left {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>; 
            bindings =
                <&macro_tap &kp LEFT_PARENTHESIS>,               
                <&macro_param_1to1>,
                <&macro_tap &kp MACRO_PLACEHOLDER>,
                <&macro_param_1to1>,
                <&macro_tap &kp MACRO_PLACEHOLDER>,
                <&macro_tap &kp RIGHT_PARENTHESIS>,
                <&macro_tap &kp LEFT_ARROW &kp LEFT_ARROW>;
        };
        m_js_fn: macro_js_anon_function {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>; 
            bindings =
                <&macro_tap &kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS>,               
                <&macro_tap &kp SPACE &kp EQUAL &kp GREATER_THAN>;
        };
        m_py_str: macro_python_string_param {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>; 
            bindings =
                <&macro_tap &kp DOLLAR>,
                <&macro_tap &kp LEFT_BRACE &kp RIGHT_BRACE>,
                <&macro_tap &kp LEFT_ARROW>;
        };
        m_dots: macro_triple_dots {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>; 
            bindings = <&macro_tap &kp DOT &kp DOT &kp DOT>;
        };
    };

// TODO: define all layers and use them
// TODO: add Insert button somewhere
// TODO: add Delete all, Paste all, Copy all, Select all macros somewhere

  keymap {
    compatible = "zmk,keymap";

    default_layer { 
    // TODO: Decide
            // Hyprland layer location
            // Meta key location
            // Home - Pagedown buttons
    // TODO: remove &to L_QWERTY
    // TODO: UA lang
    // TODO: L_KEYPAD layer on double tap
    // TODO: remove or change location of &sys_reset?
      display-name = "Base";
      bindings = <
  &kp EQUAL    &kp N1      &kp N2            &kp N3     &kp N4      &kp N5   &ht_dfn_mfst LA(SYSREQ) SYSREQ                                                                                                                           &tog L_KEYPAD   &kp N6   &kp N7   &kp N8      &kp N9     &kp N0     &kp MINUS
  &kp TAB      &kp Q       &kp W             &kp F      &kp P       &kp B    &ht_dfn_mfst LG(LC(LA(LEFT))) LG(LC(LA(RIGHT)))                                                                                                          &td_layout      &kp J    &kp L    &kp U       &kp Y      &kp SEMI   &kp BSLH
  &kp ESC      &kp A       &kp R             &kp S      &kp T       &kp G    &to L_QWERTY                                                              &kp LCTRL               &kp LALT   &kp LGUI    &kp RCTRL                       &sys_reset      &kp M    &kp N    &kp E       &kp I      &kp O      &kp SQT
  &kp LSHFT    &kp Z       &kp X             &kp C      &kp D       &kp V                                                                                                      &kp HOME   &kp PG_UP                                                   &kp K    &kp H    &kp COMMA   &kp DOT    &kp FSLH   &kp RSHFT
  &sl L_APPS   &kp GRAVE   &cw_caps CAPS 0   &kp LEFT   &kp RIGHT                                                              &ht_cl L_KEYPAD SPACE   &ht_cl L_FTOOLS ENTER   &kp END    &kp PG_DN   &ht_cl L_MEDIA DEL   &kp BSPC                            &kp UP   &kp DOWN    &kp LBKT   &kp RBKT   &kp LG(LS(L))
//    ┌───────────┬───┬──────────┬──────┬──────┬───┬─────────────┐                                                                                       ┌──────────────┬───┬────┬──────┬───┬───┬──────┐
//    │     =     │ 1 │    2     │  3   │  4   │ 5 │ screenshot  │                                                                                       │ tog L_KEYPAD │ 6 │ 7  │  8   │ 9 │ 0 │  -   │
//    ├───────────┼───┼──────────┼──────┼──────┼───┼─────────────┤                                                                                       ├──────────────┼───┼────┼──────┼───┼───┼──────┤
//    │    tab    │ Q │    W     │  F   │  P   │ B │ < worksp >  │                                                                                       │  &td_layout  │ J │ L  │  U   │ Y │ ; │  \   │
//    ├───────────┼───┼──────────┼──────┼──────┼───┼─────────────┤                     ┌───────────────────────┬──────┬──────┬────────────────────┐      ├──────────────┼───┼────┼──────┼───┼───┼──────┤
//    │    esc    │ A │    R     │  S   │  T   │ G │ to L_QWERTY │                     │         lctl          │ lalt │ lgui │        rctl        │      │  &sys_reset  │ M │ N  │  E   │ I │ O │  '   │
//    ├───────────┼───┼──────────┼──────┼──────┼───┼─────────────┘                     └───────────────────────┼──────┼──────┼────────────────────┘      └──────────────┼───┼────┼──────┼───┼───┼──────┤
//    │   lsft    │ Z │    X     │  C   │  D   │ V │                                                           │ home │ pgup │                                          │ K │ H  │  ,   │ . │ / │ rsft │
//    ├───────────┼───┼──────────┼──────┼──────┼───┘             ┌─────────────────────┬───────────────────────┼──────┼──────┼────────────────────┬──────┐              └───┼────┼──────┼───┼───┼──────┤
//    │ sl L_APPS │ ` │ caps duo │ left │ rght │                 │ &ht_cl L_KEYPAD spc │ &ht_cl L_FTOOlsft ent │ end  │ pgdn │ &ht_cl L_MEDIA del │ bspc │                  │ up │ down │ [ │ ] │ lang │
//    └───────────┴───┴──────────┴──────┴──────┘                 └─────────────────────┴───────────────────────┴──────┴──────┴────────────────────┴──────┘                  └────┴──────┴───┴───┴──────┘
      >;
    };
    qwerty { 
      display-name = "Qwerty";
      bindings = <
  &trans   &trans   &trans   &trans   &trans   &trans   &trans                                                         &trans          &trans   &trans   &trans   &trans   &trans     &trans
  &trans   &kp Q    &kp W    &kp E    &kp R    &kp T    &trans                                                         &to L_DEFAULT   &kp Y    &kp U    &kp I    &kp O    &kp P      &trans
  &trans   &kp A    &kp S    &kp D    &kp F    &kp G    &trans            &trans   &trans   &trans   &trans            &trans          &kp H    &kp J    &kp K    &kp L    &kp SEMI   &trans
  &trans   &kp Z    &kp X    &kp C    &kp V    &kp B                               &trans   &trans                                     &kp N    &kp M    &trans   &trans   &trans     &trans
  &trans   &trans   &trans   &trans   &trans                     &trans   &trans   &trans   &trans   &trans   &trans                            &trans   &trans   &trans   &trans     &trans
//    ┌───┬───┬───┬───┬───┬───┬───┐                       ┌─────────────┬───┬───┬───┬───┬───┬───┐
//    │ & │ & │ & │ & │ & │ & │ & │                       │      &      │ & │ & │ & │ & │ & │ & │
//    ├───┼───┼───┼───┼───┼───┼───┤                       ├─────────────┼───┼───┼───┼───┼───┼───┤
//    │ & │ Q │ W │ E │ R │ T │ & │                       │ to L_DEFAU< │ Y │ U │ I │ O │ P │ & │
//    ├───┼───┼───┼───┼───┼───┼───┤   ┌───┬───┬───┬───┐   ├─────────────┼───┼───┼───┼───┼───┼───┤
