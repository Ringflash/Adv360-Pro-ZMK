  };

  input_processors {
    turbo_scroll_scaler: turbo_scroll_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
            track-remainders;
        };
    };
};

// Listeners
&mmv_input_listener {
    turbo_cursor {
        layers = <L_MOUSE_TRB>;
        input-processors = <&zip_xy_scaler 4 1>;
    };
};
&msc_input_listener {
    turbo_scroll {
        layers = <L_MOUSE_TRB>;
        input-processors = <&turbo_scroll_scaler 4 1>;
    };
};
