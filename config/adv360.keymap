#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200 
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

/* PREPROCESSOR */
// Constants
#define TAP_TERM_DEF 180
#define TAP_TERM_MFAST 130
#define TAP_TERM_FAST 150
#define TAP_TERM_SLOW 200
// Layers
#define L_DEFAULT    0
#define L_QWERTY     1
#define L_MAC        2
#define L_MEDIA      3
#define L_KEYPAD     4
#define L_ARROWS     5
#define L_MOUSE      6
#define L_MOUSE_TRB  7
#define L_FTOOLS     8
#define L_FTOOLS_MAC 9
#define L_HYPRLAND   10
#define L_HYPR_GR    11
#define L_AEROSPACE  12
#define L_APPS       13
#define L_EDITOR     14
// Macros
// - tap, hold, double tap
#define TD_A1(NAME, KP) \
    NAME: NAME { \
        compatible = "zmk,behavior-tap-dance"; \
        #binding-cells = <0>; \
        bindings = <&kp KP>; \
    }
#define TD_A1_DT_TOG_LYR(NAME, LAYER) \
    NAME: NAME { \
        compatible = "zmk,behavior-tap-dance"; \
        #binding-cells = <0>; \
        tapping-term-ms = <TAP_TERM_DEF>; \
        bindings = <&none>, <&tog LAYER>; \
    }
#define TD_A1_DT_KP(NAME, KP ) \
    NAME: NAME { \
        compatible = "zmk,behavior-tap-dance"; \
        #binding-cells = <0>; \
        tapping-term-ms = <TAP_TERM_DEF>; \
        bindings = <&none>, <&kp KP>; \
    }
#define TD_A1_DT_TO_LYR(NAME, LAYER) \
    NAME: NAME { \
        compatible = "zmk,behavior-tap-dance"; \
        #binding-cells = <0>; \
        tapping-term-ms = <TAP_TERM_DEF>; \
        bindings = <&none>, <&to LAYER>; \
    }
#define TD_A2(NAME, TAP, D_TAP) \
    NAME: NAME { \
        compatible = "zmk,behavior-tap-dance"; \
        #binding-cells = <0>; \
        tapping-term-ms = <TAP_TERM_DEF>; \
        bindings = <&kp TAP>, <&kp D_TAP>; \
    }
#define TD_A3(NAME, TAP, HOLD, D_TAP) \
    NAME: NAME { \
        compatible = "zmk,behavior-tap-dance"; \
        #binding-cells = <0>; \
        tapping-term-ms = <TAP_TERM_DEF>; \
        bindings = <&ht_dfn_mfst HOLD TAP>, <&kp D_TAP>; \
    }
#define TD_A4(NAME, TAP, HOLD, D_TAP, T_TAP) \
    NAME: NAME { \
        compatible = "zmk,behavior-tap-dance"; \
        #binding-cells = <0>; \
        tapping-term-ms = <TAP_TERM_SLOW>; \
        bindings = <&ht_dfn_mfst HOLD TAP>, <&kp D_TAP>, <&kp T_TAP>; \
    }
#define TD_SL_TOG(NAME, LAYER) \
    NAME: NAME { \
        compatible = "zmk,behavior-tap-dance"; \
        #binding-cells = <0>; \
        tapping-term-ms = <TAP_TERM_DEF>; \
        bindings = <&sl LAYER>, <&tog LAYER>; \
    }

/* DEFAULT BEHAVIORS */
&mt { // Mod-Tap
    tapping-term-ms = <TAP_TERM_DEF>;
};
&lt { // Layer-Tap
    tapping-term-ms = <TAP_TERM_DEF>;
};
&sk { // Sticky key
    release-after-ms = <1500>;
};
&sl { // Sticky layer
    release-after-ms = <1500>;
    /delete-property/ quick-release;
};
&caps_word {
    continue-list = <UNDERSCORE MINUS BACKSPACE DELETE>;
};
&mmv {
    time-to-max-speed-ms = <400>;
    delay-ms = <0>;
};
&msc {
    delay-ms = <0>;
};
/* CONFIG */
/ {
    behaviors {
        // Custom
        esc_ent: mod_morph_escape_enter {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp ENTER>;
            mods = <MOD_LCTL>;
        };
        skq: sticky_key_quick_release {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1500>;
            quick-release;
            ignore-modifiers;
        };
        hrm: ht_home_row_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            /* flavor = "balanced"; */
            flavor = "tap-preferred";
            require-prior-idle-ms = <135>;
            tapping-term-ms = <TAP_TERM_DEF>;
            quick-tap-ms = <150>;
            hold-while-undecided;
            retro-tap;
            bindings = <&kp>, <&kp>;
        };
        ht_cl: ht_cluster_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred"; 
            tapping-term-ms = <TAP_TERM_SLOW>;
            quick-tap-ms = <175>;     
            retro-tap;          
            bindings = <&mo>, <&kp>;
        };
        ht_cl_tp: ht_cluster_layer_tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred"; 
            tapping-term-ms = <TAP_TERM_FAST>;
            quick-tap-ms = <TAP_TERM_FAST>;     
            retro-tap;          
            bindings = <&mo>, <&kp>;
        };
        test_lp: test_layer_press {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;      
            retro-tap;                 
            bindings = <&mo>, <&kp>;   
        };
        ht_dfn_mfst: ht_dual_function_mega_fast {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred"; 
            tapping-term-ms = <TAP_TERM_MFAST>;
            bindings = <&kp>, <&kp>;
        };
        ht_mo_sl: ht_momentary_sticky_layer { 
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <TAP_TERM_FAST>;
            bindings = <&mo>, <&sl>; 
        };
        ht_tog_sl: ht_toggle_sticky_layer { 
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <TAP_TERM_FAST>;
            bindings = <&tog>, <&sl>; 
        };
        ht_mo_tog: ht_momentary_toggle_layer { 
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <TAP_TERM_FAST>;
            bindings = <&mo>, <&tog>; 
        };
        cw_caps: caps_word_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <TAP_TERM_MFAST>;
            quick-tap-ms = <0>;
            bindings = <&kp>, <&caps_word>; 
        };
        // - Keyboard layout (qwerty/mac) switch on hold and double tap 
        to_hold_tap: to_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <TAP_TERM_DEF>;
            bindings = <&to>, <&none>;
        };
        td_layout: td_change_layout {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TAP_TERM_DEF>;
            bindings = <&to_hold_tap L_MAC 0>, <&to L_QWERTY>; 
        };
        td_bootloader: td_bootloader {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TAP_TERM_DEF>;
            bindings = <&none>, <&bootloader>; 
        };
        td_bt_cl: td_bluetooth_clear {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TAP_TERM_DEF>;
            bindings = <&none>, <&bt BT_CLR>; 
        };
        td_bt_cl_all: td_bluetooth_clear_all {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TAP_TERM_DEF>;
            bindings = <&none>, <&bt BT_CLR_ALL>; 
        };
        // tap-dance
        TD_A1_DT_TOG_LYR(td_keypad, L_KEYPAD); // toggle keypad layer on double tap
        TD_A1_DT_TO_LYR(td_l_def, L_DEFAULT); // toggle default layer on double tap
        TD_A1_DT_KP(td_sleep_lnx, LG(LS(LA(L)))); // sleep system on Linux
        TD_A1_DT_KP(td_sleep_mac, LC(LA(C_EJECT))); // sleep system on MacOS
        TD_A4(td_a4_h_res, LG(R), LG(LC(R)), LG(LA(R)), LG(LC(LA(R)))); // hyprland, resize window
        TD_A4(td_breakpoint, LC(F8), LS(LC(F8)), LS(LC(F3)), LS(LC(LA(F8)))); // editor, breakpoints
        TD_A3(td_e_methods, LS(LC(D)), LC(I), LC(O)); // editor, methods
        TD_A3(td_e_refactor, LS(F6), LC(F6), F6); // editor, refactor
        TD_A3(td_e_sur_life, LC(LA(J)), LS(LA(T)), LC(J)); // editor, surround/live template
        TD_A3(td_e_f_expand, LC(EQUAL), LC(LA(EQUAL)), LS(LC(EQUAL))); // editor, fold expand
        TD_A3(td_e_f_collapse, LC(MINUS), LC(LA(MINUS)), LS(LC(MINUS))); // editor, fold collapse
        TD_A4(td_e_bookmarks, LS(LC(LA(RIGHT_BRACKET))), F11, LS(LC(LA(LEFT_BRACKET))), LS(LC(F11))); // editor, bookmarks
        TD_SL_TOG(td_hypr, L_HYPRLAND); // hyprland layer activation
        // macros
        m_p2: macro_two_param {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>; 
            bindings =
                <&macro_param_1to1>,
                <&macro_tap &kp MACRO_PLACEHOLDER>,
                <&macro_param_2to1>,
                <&macro_tap &kp MACRO_PLACEHOLDER>;
        };
        m_p2_s: macro_two_param_with_space {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>; 
            bindings =
                <&macro_param_1to1>,
                <&macro_tap &kp MACRO_PLACEHOLDER>,
                <&macro_param_2to1>,
                <&macro_tap &kp MACRO_PLACEHOLDER>,
                <&macro_tap &kp SPACE>;
        };
        m_brkt: macro_brackets_left_left {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>; 
            bindings =
                <&macro_tap &kp LEFT_BRACKET>,               
                <&macro_param_1to1>,
                <&macro_tap &kp MACRO_PLACEHOLDER>,
                <&macro_param_1to1>,
                <&macro_tap &kp MACRO_PLACEHOLDER>,
                <&macro_tap &kp RIGHT_BRACKET>,
                <&macro_tap &kp LEFT_ARROW &kp LEFT_ARROW>;
        };
        m_paren: macro_parenthesis_left_left {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>; 
            bindings =
                <&macro_tap &kp LEFT_PARENTHESIS>,               
                <&macro_param_1to1>,
                <&macro_tap &kp MACRO_PLACEHOLDER>,
                <&macro_param_1to1>,
                <&macro_tap &kp MACRO_PLACEHOLDER>,
                <&macro_tap &kp RIGHT_PARENTHESIS>,
                <&macro_tap &kp LEFT_ARROW &kp LEFT_ARROW>;
        };
        m_js_fn: macro_js_anon_function {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>; 
            bindings =
                <&macro_tap &kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS>,               
                <&macro_tap &kp SPACE &kp EQUAL &kp GREATER_THAN>;
        };
        m_py_str: macro_python_string_param {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>; 
            bindings =
                <&macro_tap &kp DOLLAR>,
                <&macro_tap &kp LEFT_BRACE &kp RIGHT_BRACE>,
                <&macro_tap &kp LEFT_ARROW>;
        };
        m_dots: macro_triple_dots {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>; 
            bindings = <&macro_tap &kp DOT &kp DOT &kp DOT>;
        };
        m_eq3t: macro_eq_eq_eq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>; 
            bindings = <&macro_tap &kp EQUAL &kp EQUAL &kp EQUAL &kp SPACE>;
        };
        m_ne_eq2t: macro_ne_eq_eq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>; 
            bindings = <&macro_tap &kp EXCL &kp EQUAL &kp EQUAL &kp SPACE>;
        };
        m_cp_link: macro_copy_link {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>; 
            bindings = <&macro_tap &kp LC(L) &kp LC(C) &kp ESC &kp ESC>;
        };
        m_srch_tab: macro_search_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>; 
            bindings = <&macro_tap &kp LC(L) &kp PERCENT &kp SPACE>;
        };
    };

// TODO: comments formatting keyboard for all needed keys
// TODO: turn off zmk studio
// TODO: remove retrotap from clusters
// TODO: no sticky key on left alt?

  /* KEYMAP */
  keymap {
    compatible = "zmk,keymap";
    default_layer { 
      display-name = "Base";
      bindings = <
  &kp GRAVE    &kp N1     &kp N2            &kp N3     &kp N4      &kp N5   &kp PSCRN                                                                                                                                                                 &td_keypad   &kp N6   &kp N7   &kp N8      &kp N9     &kp N0     &kp EQUAL
  &kp TAB      &kp Q      &kp W             &kp F      &kp P       &kp B    &ht_tog_sl L_FTOOLS L_FTOOLS                                                                                                                                              &td_layout   &kp J    &kp L    &kp U       &kp Y      &kp SEMI   &kp MINUS
  &esc_ent     &kp A      &kp R             &kp S      &kp T       &kp G    &ht_dfn_mfst LG(LC(LA(LEFT))) LG(LC(LA(RIGHT)))                          &sk LCTRL             &sk LALT   &sk LALT      &sk RCTRL                                         &none        &kp M    &kp N    &kp E       &kp I      &kp O      &kp SQT
  &kp LSHFT    &kp Z      &kp X             &kp C      &kp D       &kp V                                                                                                   &sk LGUI   &sk RGUI                                                                     &kp K    &kp H    &kp COMMA   &kp DOT    &kp FSLH   &kp RSHFT
  &sl L_APPS   &kp BSLH   &cw_caps CAPS 0   &kp LEFT   &kp RIGHT                                                              &ht_cl L_ARROWS BSPC   &ht_cl L_KEYPAD DEL   &td_hypr   &sl L_MEDIA   &ht_cl L_EDITOR ENTER   &ht_cl_tp L_MOUSE SPACE                         &kp UP   &kp DOWN    &kp LBKT   &kp RBKT   &ht_dfn_mfst LG(LC(L)) LG(LS(L))
//    ┌───────────┬───┬──────────┬──────┬──────┬───┬──────────────────────────────────┐                                                                                                                  ┌───────────────┬───┬────┬──────┬───┬───┬──────┐
//    │     `     │ 1 │    2     │  3   │  4   │ 5 │               pscr               │                                                                                                                  │  tog KEYPAD   │ 6 │ 7  │  8   │ 9 │ 0 │  =   │
//    ├───────────┼───┼──────────┼──────┼──────┼───┼──────────────────────────────────┤                                                                                                                  ├───────────────┼───┼────┼──────┼───┼───┼──────┤
//    │    tab    │ Q │    W     │  F   │  P   │ B │ &ht_tog_sl L_FTOOlsft L_FTOOlsft │                                                                                                                  │ to QWERTY/MAC │ J │ L  │  U   │ Y │ ; │  -   │
//    ├───────────┼───┼──────────┼──────┼──────┼───┼──────────────────────────────────┤                      ┌─────────────────────┬──────────┬────────────┬─────────────────────┐                       ├───────────────┼───┼────┼──────┼───┼───┼──────┤
//    │ &esc_ent  │ A │    R     │  S   │  T   │ G │            < worksp >            │                      │      &sk lctl       │ &sk lalt │  &sk lalt  │      &sk rctl       │                       │               │ M │ N  │  E   │ I │ O │  '   │
//    ├───────────┼───┼──────────┼──────┼──────┼───┼──────────────────────────────────┘                      └─────────────────────┼──────────┼────────────┼─────────────────────┘                       └───────────────┼───┼────┼──────┼───┼───┼──────┤
//    │   lsft    │ Z │    X     │  C   │  D   │ V │                                                                               │ &sk lgui │  &sk rgui  │                                                             │ K │ H  │  ,   │ . │ / │ rsft │
//    ├───────────┼───┼──────────┼──────┼──────┼───┘                                  ┌──────────────────────┬─────────────────────┼──────────┼────────────┼─────────────────────┬───────────────────────┐               └───┼────┼──────┼───┼───┼──────┤
//    │ sl L_APPS │ \ │ caps duo │ left │ rght │                                      │ &ht_cl L_ARROWS bspc │ &ht_cl L_KEYPAD del │ &td_hypr │ sl L_MEDIA │ &ht_cl L_EDITOR ent │ &ht_cl_tp L_MOUSE spc │                   │ up │ down │ [ │ ] │ lang │
//    └───────────┴───┴──────────┴──────┴──────┘                                      └──────────────────────┴─────────────────────┴──────────┴────────────┴─────────────────────┴───────────────────────┘                   └────┴──────┴───┴───┴──────┘
      >;
    };
    qwerty { 
      display-name = "Qwerty";
      bindings = <
  &trans   &trans   &trans   &trans   &trans   &trans   &trans                                                         &trans      &trans   &trans   &trans   &trans   &trans     &trans
  &trans   &kp Q    &kp W    &kp E    &kp R    &kp T    &trans                                                         &td_l_def   &kp Y    &kp U    &kp I    &kp O    &kp P      &trans
  &trans   &kp A    &kp S    &kp D    &kp F    &kp G    &trans            &trans   &trans   &trans   &trans            &trans      &kp H    &kp J    &kp K    &kp L    &kp SEMI   &trans
  &trans   &kp Z    &kp X    &kp C    &kp V    &kp B                               &trans   &trans                                 &kp N    &kp M    &trans   &trans   &trans     &trans
  &trans   &trans   &trans   &trans   &trans                     &trans   &trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans     &trans
//    ┌───┬───┬───┬───┬───┬───┬───┐                       ┌───────────┬───┬───┬───┬───┬───┬───┐
//    │ & │ & │ & │ & │ & │ & │ & │                       │     &     │ & │ & │ & │ & │ & │ & │
//    ├───┼───┼───┼───┼───┼───┼───┤                       ├───────────┼───┼───┼───┼───┼───┼───┤
//    │ & │ Q │ W │ E │ R │ T │ & │                       │ to DEFAU< │ Y │ U │ I │ O │ P │ & │
//    ├───┼───┼───┼───┼───┼───┼───┤   ┌───┬───┬───┬───┐   ├───────────┼───┼───┼───┼───┼───┼───┤
//    │ & │ A │ S │ D │ F │ G │ & │   │ & │ & │ & │ & │   │     &     │ H │ J │ K │ L │ ; │ & │
//    ├───┼───┼───┼───┼───┼───┼───┘   └───┼───┼───┼───┘   └───────────┼───┼───┼───┼───┼───┼───┤
//    │ & │ Z │ X │ C │ V │ B │           │ & │ & │                   │ N │ M │ & │ & │ & │ & │
//    ├───┼───┼───┼───┼───┼───┘   ┌───┬───┼───┼───┼───┬───┐           └───┼───┼───┼───┼───┼───┤
//    │ & │ & │ & │ & │ & │       │ & │ & │ & │ & │ & │ & │               │ & │ & │ & │ & │ & │
//    └───┴───┴───┴───┴───┘       └───┴───┴───┴───┴───┴───┘               └───┴───┴───┴───┴───┘
      >;
    };
    mac { 
    // TODO: finish
    // TODO: modifiers location
    // TODO: check &trans
    // TODO: cluster &ht_cl
      display-name = "MacOS";
      bindings = <
  &trans   &trans   &trans   &trans   &trans   &trans   &ht_dfn_mfst LG(LS(N3)) LG(LS(N4))                                                                         &trans          &trans   &trans   &trans   &trans   &trans   &trans
  &trans   &trans   &trans   &trans   &trans   &trans   &ht_dfn_mfst LG(LS(LC(W))) LG(LC(LA(W)))                                                                   &td_l_def       &trans   &trans   &trans   &trans   &trans   &trans
  &trans   &trans   &trans   &trans   &trans   &trans   &trans                                              &sk LGUI   &trans      &trans      &sk RGUI            &kp LC(SPACE)   &trans   &trans   &trans   &trans   &trans   &trans
  &trans   &trans   &trans   &trans   &trans   &trans                                                                  &sk LCTRL   &sk RCTRL                                       &trans   &trans   &trans   &trans   &trans   &trans
  &trans   &trans   &trans   &trans   &trans                                                       &trans   &trans     &trans      &trans      &trans     &trans                            &trans   &trans   &trans   &trans   &kp LG(SPACE)
//    ┌───┬───┬───┬───┬───┬───┬────────────┐                                                   ┌───────────┬───┬───┬───┬───┬───┬──────┐
//    │ & │ & │ & │ & │ & │ & │ screenshot │                                                   │     &     │ & │ & │ & │ & │ & │  &   │
//    ├───┼───┼───┼───┼───┼───┼────────────┤                                                   ├───────────┼───┼───┼───┼───┼───┼──────┤
//    │ & │ & │ & │ & │ & │ & │ < worksp > │                                                   │ to DEFAU< │ & │ & │ & │ & │ & │  &   │
//    ├───┼───┼───┼───┼───┼───┼────────────┤   ┌──────────┬──────────┬──────────┬──────────┐   ├───────────┼───┼───┼───┼───┼───┼──────┤
//    │ & │ & │ & │ & │ & │ & │     &      │   │ &sk lgui │    &     │    &     │ &sk rgui │   │  search   │ & │ & │ & │ & │ & │  &   │
//    ├───┼───┼───┼───┼───┼───┼────────────┘   └──────────┼──────────┼──────────┼──────────┘   └───────────┼───┼───┼───┼───┼───┼──────┤
//    │ & │ & │ & │ & │ & │ & │                           │ &sk lctl │ &sk rctl │                          │ & │ & │ & │ & │ & │  &   │
