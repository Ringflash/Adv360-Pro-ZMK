#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

// Constants
#define TAP_TERM_DEF 180
#define TAP_TERM_MFAST 130
// Layers
#define L_DEFAULT 0
#define L_QWERTY 1
#define L_MAC 2
#define L_MEDIA 3
#define L_KEYPAD 4
#define L_TOOLS 5
#define L_TOOLS_MAC 6
#define L_HYPRLAND 7
#define L_HYPR_GR 8
#define L_AEROSPACE 9
#define L_APPS 10
#define L_EDITOR 11

// Default behaviors
&mt { // Mod-Tap
    tapping-term-ms = <TAP_TERM_DEF>;
};
&lt { // Layer-Tap
    tapping-term-ms = <TAP_TERM_DEF>;
};
&sk { // Sticky key
    release-after-ms = <1500>;
};
&caps_word {
    continue-list = <UNDERSCORE MINUS BACKSPACE DELETE>;
};

// Config
/ {
    behaviors {
      /* #include "macros.dtsi" */
      /* #include "version.dtsi" */
        // Custom
        ht_cl: ht_cluster_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred"; 
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;     
            retro-tap;          
            bindings = <&mo>, <&kp>;
        };
        test_lp: test_layer_press {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;      
            retro-tap;                 
            bindings = <&mo>, <&kp>;   
        };
        ht_dfn_mfst: ht_dual_function_mega_fast {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred"; 
            tapping-term-ms = <TAP_TERM_MFAST>;
            quick-tap-ms = <0>;     
            retro-tap;          
            bindings = <&kp>, <&kp>;
        };
        cw_caps: caps_word_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <135>;
            quick-tap-ms = <0>;
            bindings = <&kp>, <&caps_word>; 
        };
        // - Keyboard layout (qwerty/mac) switch on hold and double tap 
        to_hold_tap: to_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <TAP_TERM_DEF>;
            bindings = <&to>, <&none>;
        };
        td_layout: td_change_layout {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TAP_TERM_DEF>;
            bindings = <&to_hold_tap L_MAC 0>, <&to L_QWERTY>; 
        };
    };

// TODO: add // Layer to all layers
// TODO: define all layers and use them

  keymap {
    compatible = "zmk,keymap";

    default_layer { 
    // TODO: remove &to L_QWERTY
      display-name = "Base";
      bindings = <
  &kp EQUAL     &kp N1      &kp N2            &kp N3     &kp N4      &kp N5   &ht_dfn_mfst LA(SYSREQ) SYSREQ                                                                                                               &none        &kp N6   &kp N7   &kp N8      &kp N9     &kp N0     &kp MINUS
  &kp TAB       &kp Q       &kp W             &kp F      &kp P       &kp B    &ht_dfn_mfst LG(LC(LA(LEFT))) LG(LC(LA(RIGHT)))                                                                                              &td_layout   &kp J    &kp L    &kp U       &kp Y      &kp SEMI   &kp BSLH
  &kp ESC       &kp A       &kp R             &kp S      &kp T       &kp G    &to L_QWERTY                                                  &kp LCTRL               &kp LALT   &kp LGUI    &kp RCTRL                       &none        &kp M    &kp N    &kp E       &kp I      &kp O      &kp SQT
  &kp LSHFT     &kp Z       &kp X             &kp C      &kp D       &kp V                                                                                          &kp HOME   &kp PG_UP                                                &kp K    &kp H    &kp COMMA   &kp DOT    &kp FSLH   &kp RSHFT
  &mo L_TOOLS   &kp GRAVE   &cw_caps CAPS 0   &kp LEFT   &kp RIGHT                                                              &kp SPACE   &ht_cl L_KEYPAD ENTER   &kp END    &kp PG_DN   &ht_cl L_MEDIA DEL   &kp BSPC                         &kp UP   &kp DOWN    &kp LBKT   &kp RBKT   &kp LG(LS(L))
