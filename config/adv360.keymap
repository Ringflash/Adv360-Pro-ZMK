  &none   &none   &none   &none       &kp LS(LC(SLASH))   &none                            &none   &none                           &none   &none   &none   &none   &none   &none
  &none   &none   &none   &kp LC(Y)   &kp LC(SLASH)                       &kp F5   &none   &none   &none   &none   &none                   &none   &none   &none   &none   &none
//    ┌─────┬─────┬─────┬─────────┬───────────────┬─────┬─────┐                                  ┌─────┬─────┬─────┬─────┬─────┬─────┬─────┐
//    │     │     │     │         │               │     │     │                                  │     │     │     │     │     │     │     │
//    ├─────┼─────┼─────┼─────────┼───────────────┼─────┼─────┤                                  ├─────┼─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │         │               │     │     │                                  │     │     │     │     │     │     │     │
//    ├─────┼─────┼─────┼─────────┼───────────────┼─────┼─────┤    ┌─────┬─────┬─────┬─────┐     ├─────┼─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │         │ lctl(lalt(L)) │     │     │    │     │     │     │     │     │     │     │     │     │     │     │     │
//    ├─────┼─────┼─────┼─────────┼───────────────┼─────┼─────┘    └─────┼─────┼─────┼─────┘     └─────┼─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │         │ lsft(lctl(/)) │     │                │     │     │                 │     │     │     │     │     │     │
//    ├─────┼─────┼─────┼─────────┼───────────────┼─────┘     ┌────┬─────┼─────┼─────┼─────┬─────┐     └─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │ lctl(Y) │    lctl(/)    │           │ f5 │     │     │     │     │     │           │     │     │     │     │     │
//    └─────┴─────┴─────┴─────────┴───────────────┘           └────┴─────┴─────┴─────┴─────┴─────┘           └─────┴─────┴─────┴─────┴─────┘
      >;
    };

    extra2 { 
      display-name = "Purple";    
      status = "reserved";
    };

    extra3 { 
      display-name = "Cyan";    
      status = "reserved";
    };

    extra4 { 
      display-name = "Yellow";    
      status = "reserved";
    };
  };
};
